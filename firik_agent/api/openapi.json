  "components": {
    "schemas": {
      "Body_audio_transcriptions_v1_audio_transcriptions_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "Audio file to transcribe."
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "ID of the transcription model to use."
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "description": "ISO 639-1 language code hint, if known."
          },
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "description": "Optional text to guide the model's style or vocabulary.",
            "default": ""
          },
          "response_format": {
            "type": "string",
            "enum": [
              "json",
              "text",
              "srt",
              "verbose_json",
              "diarized_json"
            ],
            "title": "Response Format",
            "description": "Output format: `json`, `text`, `srt`, `verbose_json` or `diarized_json`.",
            "default": "json"
          },
          "temperature": {
            "type": "number",
            "title": "Temperature",
            "description": "Sampling temperature between 0 and 1.",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "file",
          "model"
        ],
        "title": "Body_audio_transcriptions_v1_audio_transcriptions_post"
      },
      "ChatCompletionRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "ID of the model to use. See `GET /v1/models`."
          },
          "messages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Messages",
            "description": "Conversation so far, as a list of `{role, content}` objects."
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "description": "If true, partial message deltas are sent as server-sent events.",
            "default": false
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens",
            "description": "Maximum number of tokens to generate."
          },
          "evren_tools": {
            "type": "boolean",
            "title": "Firik Tools",
            "description": "FIRIK extension (non-standard): opt-in to server-executed live-data tools when `tools` is not supplied.",
            "default": false
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "title": "ChatCompletionRequest",
        "description": "OpenAI sözleşmesinin GEREKLİ alanları - diğer tüm parametreler\n(reasoning_effort, tools, seed, top_k, stop...) `extra='allow'` ile\nolduğu gibi vLLM'e geçer; yetenek doğrulaması chat_service'te ayrıca yapılır."
      },
      "CompleteUploadRequest": {
        "properties": {
          "parts": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CompletedPart"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parts",
            "description": "Parts to finalize (multipart uploads only)."
          }
        },
        "type": "object",
        "title": "CompleteUploadRequest"
      },
      "CompletedPart": {
        "properties": {
          "part_number": {
            "type": "integer",
            "title": "Part Number",
            "description": "1-indexed part number for multipart upload."
          },
          "etag": {
            "type": "string",
            "title": "Etag",
            "description": "ETag returned by the storage backend for this part."
          }
        },
        "type": "object",
        "required": [
          "part_number",
          "etag"
        ],
        "title": "CompletedPart"
      },
      "CompletionRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "ID of the model to use."
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Prompt",
            "description": "Prompt(s) to generate completions for."
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "description": "If true, partial completions are sent as server-sent events.",
            "default": false
          },
          "max_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens",
            "description": "Maximum number of tokens to generate."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "title": "CompletionRequest",
        "description": "t32 - eski `/v1/completions` sözleşmesi (`prompt` string, `messages` değil)."
      },
      "EmbeddingsRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "ID of the embedding model to use."
          },
          "input": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ],
            "title": "Input",
            "description": "Text (or list of texts) to embed."
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "title": "EmbeddingsRequest",
        "description": "t48 - OpenAI `/v1/embeddings` sözleşmesi; gerçek qwen3-embedding-8b\nile doğrulandı (`input` tekil string VEYA liste kabul eder)."
      },
      "FinalizeMediaResponse": {
        "properties": {
          "media_id": {
            "type": "string",
            "title": "Media Id",
            "description": "Media identifier."
          },
          "state": {
            "type": "string",
            "title": "State",
            "description": "Current processing state (READY on success)."
          },
          "finalized_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finalized Key",
            "description": "Object key in the finalized (permanent) bucket."
          }
        },
        "type": "object",
        "required": [
          "media_id",
          "state"
        ],
        "title": "FinalizeMediaResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
