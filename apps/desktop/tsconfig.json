{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": { "@firik/contracts": ["../../packages/contracts/src/index.ts"] }
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "../../packages/contracts/src"]
}
