# Optional legacy environment configuration. No .env file is required.
# Run firik or firik-agent to enter and save your key in the OS credential store.
# Use firik login to replace a saved key. Environment values take precedence.
# FIRIK API Credentials
# Direct FIRIK endpoint: https://evren-llmapi.ssyz.org.tr/v1
# Select the LLM Çıkarım key type in the portal (Platform keys are separate).
FIRIK_API_KEY=firik_llm_your_key_here
# Optional direct CLI override:
# FIRIK_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1

# LLMTR Gateway Credentials
# LLMTR endpoint: https://llmtr.com/v1
LLMTR_API_KEY=llmtr-your_key_here

# Optional: Other providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
