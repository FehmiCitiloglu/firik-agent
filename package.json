{
  "name": "firik-agent-workspace",
  "version": "0.2.51",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.12 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "desktop:dev": "node scripts/desktop_dev.mjs",
    "desktop:build": "node scripts/build_desktop.mjs",
    "desktop:start": "electron apps/desktop",
    "desktop:check": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "desktop:test": "vitest run --config apps/desktop/vitest.config.ts",
    "desktop:browser:install": "node scripts/prepare_hybrid_browser.mjs",
    "desktop:test:browser": "node scripts/test_hybrid_browser.mjs",
    "desktop:smoke": "node scripts/smoke_hybrid_desktop.mjs",
    "desktop:package": "node scripts/package_hybrid_desktop.mjs",
    "contracts:generate": "node scripts/generate_desktop_contracts.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
